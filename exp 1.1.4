#include <stdio.h>
#include <stdlib.h>
#include <limits.h>

void kruskalMST(int **cost, int V) {
    int parent[100];
    int edges[4950][3];
    int edgeCount = 0;

    /* Create edge list in row-wise order */
    for (int i = 0; i < V; i++) {
        for (int j = i + 1; j < V; j++) {
            if (cost[i][j] != 9999) {
                edges[edgeCount][0] = i;
                edges[edgeCount][1] = j;
                edges[edgeCount][2] = cost[i][j];
                edgeCount++;
            }
        }
    }

    /* Sort by weight.
       For equal weights, preserve row-wise order. */
    for (int i = 1; i < edgeCount; i++) {
        int tempU = edges[i][0];
        int tempV = edges[i][1];
        int tempW = edges[i][2];

        int j = i - 1;

        while (j >= 0 && edges[j][2] > tempW) {
            edges[j + 1][0] = edges[j][0];
            edges[j + 1][1] = edges[j][1];
            edges[j + 1][2] = edges[j][2];
            j--;
        }

        edges[j + 1][0] = tempU;
        edges[j + 1][1] = tempV;
        edges[j + 1][2] = tempW;
    }

    /* Initialize parent */
    for (int i = 0; i < V; i++)
        parent[i] = i;

    int count = 0;
    int totalCost = 0;

    /* Kruskal's algorithm */
    for (int i = 0; i < edgeCount && count < V - 1; i++) {

        int u = edges[i][0];
        int v = edges[i][1];
        int w = edges[i][2];

        /* Find root of u */
        int rootU = u;
        while (parent[rootU] != rootU)
            rootU = parent[rootU];

        /* Find root of v */
        int rootV = v;
        while (parent[rootV] != rootV)
            rootV = parent[rootV];

        /* Different sets -> select edge */
        if (rootU != rootV) {
            parent[rootU] = rootV;

            printf("Edge %d:(%d, %d) cost:%d\n",
                   count, u, v, w);

            totalCost += w;
            count++;
        }
    }

    printf("Minimum cost= %d\n", totalCost);
}

    

int main() {
    int V;
    printf("No of vertices: ");
    scanf("%d", &V);

    int **cost = (int **)malloc(V * sizeof(int *));
    for (int i = 0; i < V; i++)
        cost[i] = (int *)malloc(V * sizeof(int));

    printf("Adjacency matrix:\n");
    for (int i = 0; i < V; i++)
        for (int j = 0; j < V; j++)
            scanf("%d", &cost[i][j]);

    kruskalMST(cost, V);

    for (int i = 0; i < V; i++)
        free(cost[i]);
    free(cost);

    return 0;
}
